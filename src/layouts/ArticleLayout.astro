---
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/comments/Comments.astro";
import ArticleRow from "../components/articles/ArticleRow.astro";
import { published, type Entry } from "../utils/content";
import { formatDate } from "../utils/dates";
import { readingTime } from "../utils/reading-time";
const { entry } = Astro.props as { entry: Entry };
const related = (await published(entry.collection))
  .filter((e) => e.id !== entry.id)
  .sort(
    (a, b) =>
      b.data.tags.filter((t) => entry.data.tags.includes(t)).length -
      a.data.tags.filter((t) => entry.data.tags.includes(t)).length,
  )
  .slice(0, 2);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={entry.data.canonical}
  image={`/og/${entry.collection}-${entry.id}.png`}
  article={entry.data}
  ><article data-pagefind-body>
    <header class="article-header">
      <a class="eyebrow" href={`/${entry.collection}/`}
        >{entry.collection} / {entry.data.tags.join(" / ")}</a
      ><h1 data-pagefind-meta="title">{entry.data.title}</h1><p
        class="description"
        data-pagefind-meta="description"
      >
        {entry.data.description}
      </p><div class="meta">
        <span>By Vidya</span><span>·</span><time
          datetime={entry.data.publishedAt.toISOString()}
          >{formatDate(entry.data.publishedAt)}</time
        ><span>·</span><span>~{readingTime(entry.body)} min of your life</span>{
          entry.data.updatedAt && (
            <span>Changed my mind on {formatDate(entry.data.updatedAt)}</span>
          )
        }
      </div>
    </header><div class="reading-column">
      {
        "technologies" in entry.data && (
          <div class="tag-list" data-pagefind-ignore>
            <span class="tag">{entry.data.status}</span>
            {entry.data.technologies.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }<div class="prose"><slot /></div>{
        "github" in entry.data && entry.data.github && (
          <a class="text-link" href={entry.data.github}>
            Source on GitHub ↗
          </a>
        )
      }{
        "demo" in entry.data && entry.data.demo && (
          <a class="text-link" href={entry.data.demo}>
            View the build ↗
          </a>
        )
      }
    </div>
  </article><div class="reading-column article-end">
    <Comments />{
      related.length > 0 && (
        <section class="related">
          <div class="section-heading">
            <h2>
              More questionable decisions<span class="accent">.</span>
            </h2>
          </div>
          {related.map((entry) => (
            <ArticleRow entry={entry} />
          ))}
        </section>
      )
    }<a class="text-link" href={`/${entry.collection}/`}
      >← Back to {entry.collection}</a
    >
  </div></BaseLayout
>
