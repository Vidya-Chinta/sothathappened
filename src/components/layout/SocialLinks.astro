---
import { socialLinks } from "../../data/social";
const { label = "Elsewhere" } = Astro.props;
---

<nav class="social-links" aria-label={label}>
  {
    socialLinks.map(({ label, href }) => (
      <a href={href} rel={href.startsWith("https:") ? "me" : undefined}>
        {label}
      </a>
    ))
  }
</nav>
<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    row-gap: 0.25rem;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.3em;
  }
  .social-links a:is(:hover, :focus-visible) {
    text-decoration-color: var(--accent);
  }
</style>
